# DevOps Companion Application Environment Variables
# Copy this file to .env and update the values

# =============================================================================
# JWT Authentication Configuration
# =============================================================================
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-minimum-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# AWS Configuration
# =============================================================================
# Option 1: Use AWS Access Keys (Less Secure)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_DEFAULT_REGION=us-east-1

# Option 2: Use IAM Roles (Recommended for Production)
# AWS_PROFILE=default
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/DevOpsCompanionRole

# =============================================================================
# Google Cloud Platform Configuration
# =============================================================================
GCP_PROJECT_ID=your-gcp-project-id

# Option 1: Use Service Account Key File (Less Secure)
GCP_SERVICE_ACCOUNT_KEY_PATH=./gcp-credentials.json

# Option 2: Use Application Default Credentials (Recommended for Production)
# GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-credentials.json

# =============================================================================
# Application Configuration
# =============================================================================
DEBUG=False
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4

# Frontend Configuration
FRONTEND_PORT=3000

# =============================================================================
# Database Configuration (Optional)
# =============================================================================
# POSTGRES_DB=devops_companion
# POSTGRES_USER=devops
# POSTGRES_PASSWORD=secure_password_change_this
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# =============================================================================
# Redis Configuration (Optional)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# Security Configuration
# =============================================================================
# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# Monitoring Configuration (Optional)
# =============================================================================
# PROMETHEUS_ENABLED=False
# PROMETHEUS_PORT=9090

# =============================================================================
# SSH Configuration
# =============================================================================
# SSH Keys Directory (relative to project root)
SSH_KEYS_DIR=./ssh-keys

# =============================================================================
# Production Overrides
# =============================================================================
# Uncomment and modify for production deployment

# SECRET_KEY=production-secret-key-minimum-32-characters-long
# DEBUG=False
# LOG_LEVEL=WARNING
# BACKEND_WORKERS=8
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

